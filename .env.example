# ========================
# LLM Configuration
# ========================

# OpenAI (default provider)
OPENAI_API_KEY=sk_test_...
OPENAI_MODEL=gpt-4o-mini          # gpt-4, gpt-3.5-turbo, gpt-4o, ecc.
OPENAI_VECTOR_STORE_ID=vs_...      # OpenAI Files API vector store ID

# Ollama (local, free — uncomment to use)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ========================
# Database Configuration (Optional)
# ========================

# PostgreSQL connection — only if you load context from DB
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_db

# ========================
# Authentication (Optional)
# ========================

# NextAuth (only if you want server-side auth + rate limit per user)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-with-`openssl rand -base64 32`

# ========================
# Assistant Configuration
# ========================

# System prompt — defines the assistant's personality and behavior
NEXT_PUBLIC_SYSTEM_PROMPT="Tu sei un esperto assistente AI. Rispondi in modo chiaro e conciso. Se non conosci la risposta, ammettilo onestamente."

# Or load from file:
# SYSTEM_PROMPT_FILE=./prompts/system.txt

# ========================
# UI Configuration
# ========================

# Chat endpoint URL (usually relative)
NEXT_PUBLIC_CHAT_ENDPOINT=/api/chat

# Widget positioning (in pixels, negative = offset from top-right)
NEXT_PUBLIC_HELPER_OFFSET_X=-360
NEXT_PUBLIC_HELPER_OFFSET_Y=-490

# Chat panel offset
NEXT_PUBLIC_CHAT_PANEL_OFFSET_X=-300
NEXT_PUBLIC_CHAT_PANEL_OFFSET_Y=-200

# ========================
# Rate Limiting
# ========================

# IP-based rate limit (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Max characters per message
RATE_LIMIT_MESSAGE_LENGTH=2000

# ========================
# LLM Behavior
# ========================

# Max tokens in response
RESPONSE_MAX_TOKENS=400

# Temperature (0.0-2.0): higher = more creative/random, lower = more deterministic
LLM_TEMPERATURE=0.6

# Top P (nucleus sampling, 0.0-1.0)
LLM_TOP_P=0.9

# Streaming timeout (milliseconds)
LLM_TIMEOUT_MS=120000

# Max chat history messages to include
MAX_HISTORY_MESSAGES=10

# ========================
# Logging & Debug
# ========================

# Node debug namespace (e.g., "rag-assistant:*" or "rag-assistant:llm")
# DEBUG=rag-assistant:*

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# ========================
# Deployment / Advanced
# ========================

# Node environment
NODE_ENV=development

# Sentry error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://...

# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,https://myapp.com

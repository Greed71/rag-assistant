{
  "name": "rag-assistant",
  "version": "0.1.0",
  "description": "Pluggable RAG (Retrieval-Augmented Generation) assistant framework. Stream-enabled, supports custom vector stores, LLMs, and database context. Built on OpenAI API with SSE streaming.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "assistant",
    "ai",
    "openai",
    "vector-store",
    "streaming",
    "sse",
    "llm"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.0.0",
    "openai": "^4.70.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.4.38"
  }
}
